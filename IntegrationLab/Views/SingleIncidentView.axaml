<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IntegrationLab.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="IntegrationLab.Views.SingleIncidentView"
             x:DataType="vm:SingleIncidentViewModel">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:SingleIncidentViewModel />
    </Design.DataContext>

    <UserControl.Resources>
        <SolidColorBrush x:Key="PageBackground" Color="#F5F7FB" />
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="DividerBrush" Color="#E6E8ED" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="ChipBackground" Color="#F1F3F5" />
    </UserControl.Resources>
    <UserControl.Styles>


        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,8" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto *" Background="{StaticResource PageBackground}">
        <Border
            Background="{StaticResource CardBackground}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,10">
            <Grid ColumnDefinitions="40,*,40" VerticalAlignment="Center">
                <Button Grid.Column="0" Background="Transparent" BorderThickness="0">
                    <TextBlock Text="✕" FontSize="20" />
                </Button>
                <TextBlock Grid.Column="1" Text="Инцидент по рейсу №123"
                           HorizontalAlignment="Center" FontSize="18" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <Grid Margin="16,12">
                <Border Background="{StaticResource CardBackground}" CornerRadius="24" Padding="16">
                    <Grid RowDefinitions="Auto Auto Auto *">
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto Auto Auto" RowSpacing="10">
                            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Дата происшествия" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Classes="value"
                                       Text="{Binding Incident.IncidentDate, StringFormat=dd.MM.yyyy\, HH:MM}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="ТС" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Classes="value"
                                       Text="{Binding Incident.Shipping.Vehicle.VehicleFullName}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Статус" />
                            <Border Grid.Row="2" Grid.Column="1" Background="{StaticResource ChipBackground}"
                                    Padding="10,4" CornerRadius="12" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Incident.Status}" FontSize="13" />
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Height="1" Background="{StaticResource DividerBrush}" Margin="-16,8,-16,8" />

                        <TextBlock Grid.Row="2" Classes="sectionTitle" Text="Описание" />
                        <Border Grid.Row="3" CornerRadius="12" BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="1" Padding="12" Background="#FAFBFD">
                            <TextBlock VerticalAlignment="Stretch" Text="{Binding Incident.Description}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>

</UserControl>