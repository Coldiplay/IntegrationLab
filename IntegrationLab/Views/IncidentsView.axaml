<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IntegrationLab.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:IncidentsViewModel"
             x:Class="IntegrationLab.Views.IncidentsView">
    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
         to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:IncidentsViewModel />
    </Design.DataContext>
    
   <UserControl.Resources>
    <!-- Цвета/кисти -->
    <SolidColorBrush x:Key="PageBackground" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#E6E8ED"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="ChipBackground" Color="#F1F3F5"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2F80ED"/>
  </UserControl.Resources>
  
  <UserControl.Styles>
    

    <!-- Тексты -->
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,4,0,8"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="TextBlock.value">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Карточка списка -->
    <Style Selector="Border.listCard">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{StaticResource CardBackground}"/>
      <Setter Property="Padding" Value="12"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <!-- Чип -->
    <Style Selector="Border.chip">
      <Setter Property="Background" Value="{StaticResource ChipBackground}"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10,4"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto *" Background="{StaticResource PageBackground}">
    <!-- Верхняя панель -->
    <Border
            Background="{StaticResource CardBackground}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,10">
      <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
        <TextBlock Grid.Column="0"
                   Text="Происшествия"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="18"
                   FontWeight="SemiBold"/>
        <Button Grid.Column="1"
                BorderThickness="0"
                ToolTip.Tip="Закрыть">
          <TextBlock Text="Создать" FontSize="20"/>
        </Button>
      </Grid>
    </Border>

    <!-- Контент -->
    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="16,12" Spacing="12">
        <Border Background="{StaticResource CardBackground}"
                CornerRadius="24"
                Padding="16">
          <Grid>
            <ScrollViewer>
              <ListBox ItemsSource="{Binding Incidents}">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Classes="listCard">
                      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Рейс №123"
                                   FontWeight="SemiBold" FontSize="16"/>
                        <Border Grid.Row="0" Grid.Column="1" Classes="chip" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding Status}" FontSize="13"/>
                        </Border>
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="{Binding IncidentDate, StringFormat={}dd.mm.yyyy\, HH:MM}"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <!-- <TextBlock Grid.Row="1" Grid.Column="1" -->
                        <!--            Text="Двойной тап — детали" -->
                        <!--            Foreground="{StaticResource TextSecondaryBrush}"/> -->
                      </Grid>
                    </Border>        
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </ScrollViewer>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
