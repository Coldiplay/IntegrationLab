<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IntegrationLab.ViewModels"
             xmlns:model="using:BaseLibrary.Model.Classes"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="IntegrationLab.Views.ShippingsView"
             x:DataType="vm:ShippingsViewModel">
    
    <UserControl.DataTemplates>
        <DataTemplate DataType="model:Shipping">
            <Grid ColumnDefinitions="*, Auto" 
                  RowDefinitions="Auto, Auto, Auto" 
                  
                  Background="Transparent"
                  DoubleTapped="OnDoubleTapped">
                <Grid.Styles>
                    <Style Selector="Label">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="#404040" />
                    </Style>
                </Grid.Styles>

                <!-- Верхняя левая: Название рейса -->
                <Label Grid.Row="0" Grid.Column="0" 
                       Content="{Binding Id, StringFormat={}Рейс №{0}}" 
                       FontWeight="Bold" />

                <!-- Верхняя правая: Статус -->
                
                <Border Name="StatusBadge" 
                        Grid.Row="0" Grid.Column="1" 
                        CornerRadius="10" 
                        Padding="8,2" 
                        HorizontalAlignment="Right">
                    <StackPanel>
                        <Label Tag="{Binding ShippingStatus}"
                               Content="{Binding ShippingStatus, Converter={StaticResource ShippingStatusConverter}}"/>
                        <Label Content="{Binding ConfirmedStatus}" 
                               FontSize="10" 
                               FontWeight="Bold" 
                               Foreground="White" />
                    </StackPanel>
                </Border>

                <!-- Средняя левая: Дата отправления -->
                <Label Grid.Row="1" Grid.Column="0" 
                       Content="{Binding ShippedDate, StringFormat={}Отпр. dd.MM.yyyy}" 
                       Foreground="#707070" />

                <!-- Нижняя правая: Груз (Количество и Вес) -->
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Label Content="{Binding CargoCount, StringFormat={}Груз: {0} шт. }" Foreground="#808080" />
                    <Label Content="{Binding CargoWeight, StringFormat={}{0:F1} т}" Foreground="#808080" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <UserControl.Styles>
        <!-- Стиль для ListBox: убираем дефолтные рамки и делаем фон прозрачным -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectedItem" Value="{Binding SelectedShipping}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!-- Стиль для элемента списка: убираем дефолтные границы -->
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Стиль для контейнера-блока. Именно он отвечает за серый фон -->
        <Style Selector="Border.BlockBorder">
            <Setter Property="Background" Value="#F2F3F5" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="Padding" Value="15,10" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style Selector="Grid.BlockSP">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,15" />
        </Style>
        
        <Style Selector="Label[Tag=InProcessing]">
            <Setter Property="Background" Value="Yellow"/>
        </Style>
        
        <Style Selector="Label[Tag=ReadyToShip]">
            <Setter Property="Background" Value="YellowGreen"/>
        </Style>
        
        <Style Selector="Label[Tag=Shipping]">
            <Setter Property="Background" Value="LightBlue"/>
        </Style>
        
        <Style Selector="Label[Tag=Delivered]">
            <Setter Property="Background" Value="Green"/>
        </Style>
        <Style Selector="Label[Tag=Incident]">
            <Setter Property="Background" Value="IndianRed"/>
        </Style>
        
        
    </UserControl.Styles>

    <Design.DataContext>
        <vm:ShippingsViewModel />
    </Design.DataContext>

    <Grid Margin="20,10,20,5" RowDefinitions="0.5*, 0.5*">
        
        <!-- Секция "ТЕКУЩИЙ И ПРЕДСТОЯЩИЕ" -->
        <Grid Grid.Row="0" RowDefinitions="Auto, *" Classes="BlockSP">
            <Label Content="ТЕКУЩИЙ И ПРЕДСТОЯЩИЕ" 
                   FontWeight="Bold" 
                   FontSize="13" 
                   Foreground="#606060" 
                   Margin="0,0,0,8" />
            
            <Border Grid.Row="1" Classes="BlockBorder">
                <ScrollViewer>
                    <ListBox ItemsSource="{Binding CurrentShippings}">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Подтвердить"
                                          Command="{Binding ConfirmShippingCommand}"
                                          CommandParameter="{Binding SelectedShipping}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Секция "ЗАВЕРШЁННЫЕ" -->
        <Grid Grid.Row="1" RowDefinitions="Auto, *" Classes="BlockSP">
            <Label Content="ЗАВЕРШЁННЫЕ" 
                   FontWeight="Bold" 
                   FontSize="13" 
                   Foreground="#606060" 
                   Margin="0,0,0,8" />
            
            <Border Grid.Row="1" Classes="BlockBorder">
                <ScrollViewer>
                    <ListBox ItemsSource="{Binding PastShippings}" />
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</UserControl>